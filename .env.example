# --- Telegram (required) ---
TELEGRAM_TOKEN=123456:ABC-YourBotFatherToken
TELEGRAM_CHAT_ID=42          # owner chat — the only chat the bot ever answers

# --- LLM backend (required) ---
LLM_BACKEND=nim

# local llama.cpp / Ollama (no cloud needed):
LLAMACPP_BASE_URL=http://localhost:8080/v1
LLAMACPP_MODEL=local
LLAMACPP_API_KEY=

# ZEN
ZEN_BASE_URL=https://opencode.ai/zen/v1
ZEN_MODEL=deepseek-v4-flash-free
ZEN_API_KEY=env:OPENCODE_API_KEY

# NVIDIA NIM
NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NIM_MODEL=meta/llama-3.1-8b-instruct
NIM_API_KEY=env:NVIDIA_API_KEY

# GOO
GOO_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
GOO_MODEL=gemini-3-flash-preview
GOO_API_KEY=env:GOOGLE_AI_STUDIO_API_KEY

# SearXNG (optional)
SEARXNG_URL=http://host.local:8888

# Tuning
DIGEST_HOUR=8
IGNORE_AFTER_H=12
TOP_N=30
MIN_SCORE=10
PROFILE_EXAMPLES=30
SCORE_BATCH=10
ARTICLE_MAX_AGE_DAYS=7
LLM_MIN_INTERVAL=3
LLM_MAX_RETRIES=4
